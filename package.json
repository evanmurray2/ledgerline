{
  "name": "ledgerline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node tools/check.mjs",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter \"./packages/**\" --filter @ledgerline/web --if-present test",
    "test:integration": "pnpm --filter @ledgerline/worker test",
    "test:e2e": "pnpm --filter @ledgerline/e2e test && pnpm --filter @ledgerline/e2e test:worker"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "fast-check": "4.3.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "ws": "^8.21.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "11.0.1"
    }
  }
}
