# Security headers for the web app. Cloudflare applies this file to every static response (the app shell and its
# files) before the Worker runs; API responses get theirs from apps/worker/src/http/security.ts.
# Plaid Link is the only third-party code: its script and iframe come from cdn.plaid.com.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.plaid.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.plaid.com; frame-src https://cdn.plaid.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
