# Security headers for the web app. Cloudflare applies this file to every static response (the app shell and its
# files) before the Worker runs; API responses get theirs from apps/worker/src/http/security.ts.
# No third-party code: every script, frame and request is this site's own (docs/privacy.md 5.7). Banks are linked on
# Plaid's own site, which the app only goes to. 'wasm-unsafe-eval' lets the phone's engine compile SQLite (WebAssembly only; JavaScript eval stays off), and
# workers come only from this site (D-45). apps/web/test/headers.test.ts fails if any of these gets looser.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
