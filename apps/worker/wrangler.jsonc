{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Production. D1 database created Nov 1, 2026 (docs/runbooks/setup.md).
  "name": "ledgerline",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ledgerline",
      "database_id": "52a5b8a6-09b1-4b27-b0bd-ddfaefd943b3",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "workflows": [
    { "name": "ledgerline-sync", "binding": "SYNC", "class_name": "SyncWorkflow" },
    { "name": "ledgerline-maintenance", "binding": "MAINTENANCE", "class_name": "MaintenanceWorkflow" },
    { "name": "ledgerline-recompute", "binding": "RECOMPUTE", "class_name": "RecomputeWorkflow" },
  ],
  // 3 of the 5 free cron triggers: sync backstop, daily stale-pending scan, daily maintenance (10:20 UTC).
  "triggers": { "crons": ["7 */4 * * *", "10 8 * * *", "20 10 * * *"] },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__dev/*", "/__measure/*"],
  },
  // Production runs Plaid Production. Local dev (.dev.vars) and tests set PLAID_ENV=sandbox explicitly.
  "vars": { "PLAID_ENV": "production", "APP_VERSION": "0.1.0" },
  // Staging: a separate Worker with its own D1, secrets, setup code and Plaid Sandbox (design: One
  // Cloudflare account). D1 database created Nov 1, 2026.
  "env": {
    "staging": {
      "name": "ledgerline-staging",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ledgerline-staging",
          "database_id": "dd5f73ff-487b-4fb3-a975-3c9b4531047e",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "workflows": [
        { "name": "ledgerline-staging-sync", "binding": "SYNC", "class_name": "SyncWorkflow" },
        {
          "name": "ledgerline-staging-maintenance",
          "binding": "MAINTENANCE",
          "class_name": "MaintenanceWorkflow",
        },
        { "name": "ledgerline-staging-recompute", "binding": "RECOMPUTE", "class_name": "RecomputeWorkflow" },
      ],
      "triggers": { "crons": [] },
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "vars": { "PLAID_ENV": "sandbox", "APP_VERSION": "0.1.0" },
    },
  },
}
