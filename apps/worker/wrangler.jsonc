{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Production. All data lives in SQLite Durable Objects (docs/multi-user.md): a Directory and one store per
  // budget. D1 and Workflows were removed on Nov 2, 2026 after the move (decisions.md D-37). Local dev, tests and e2e
  // use this same config, with local settings from .dev.vars or --var.
  "name": "ledgerline",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // docs/multi-user.md: the Directory and one BudgetStore per budget.
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "BUDGET", "class_name": "BudgetStore" },
    ],
  },
  "migrations": [{ "tag": "v1-stores", "new_sqlite_classes": ["Directory", "BudgetStore"] }],
  // Sign-in, setup, recovery and sign-up attempts per IP (docs/multi-user.md 7.2). Approximate, per location.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } }],
  // 1 of the 5 free cron triggers: wakes the Directory daily at 10:20 UTC; each budget runs its own jobs on alarms.
  "triggers": { "crons": ["20 10 * * *"] },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__dev/*"],
  },
  // Production runs Plaid Production. Local dev (.dev.vars) and tests set PLAID_ENV=sandbox explicitly.
  "vars": { "PLAID_ENV": "production", "APP_VERSION": "0.1.0" },
}
