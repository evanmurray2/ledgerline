{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  // Phase 0 of docs/multi-user.md: a throwaway Worker, separate from the live app ("ledgerline"). Deployed and
  // deleted by .github/workflows/phase0.yml. It has no D1, no secrets and no Plaid keys.
  "name": "ledgerline-phase0",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Phase0Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Phase0Store"] }],
}
